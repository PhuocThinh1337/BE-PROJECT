{
  "info": {
    "name": "NCC Backend - Authentication",
    "description": "Postman requests for the NestJS authentication API. Set collection variables before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3002/api/v1" },
    { "key": "username", "value": "so_admin" },
    { "key": "password", "value": "Test@123456" },
    { "key": "email", "value": "" },
    { "key": "newPassword", "value": "NewTest@123456" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "resetToken", "value": "" }
  ],
  "item": [
    {
      "name": "Login - valid credentials",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"rememberMe\": false\n}" },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Login returns 200', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "pm.test('Access and refresh tokens are returned', () => { pm.expect(body.data.accessToken).to.be.a('string'); pm.expect(body.data.refreshToken).to.be.a('string'); });",
        "pm.collectionVariables.set('accessToken', body.data.accessToken);",
        "pm.collectionVariables.set('refreshToken', body.data.refreshToken);",
        "pm.collectionVariables.set('role', body.data.user.role);"
      ] } }]
    },
    {
      "name": "Login - invalid credentials (expect 401)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"wrong-password\"\n}" },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Invalid credentials return 401', () => pm.response.to.have.status(401));"] } }]
    },
    {
      "name": "Me - bearer access token",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/auth/me" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Me returns 200', () => pm.response.to.have.status(200));", "pm.test('Role is present', () => pm.expect(pm.response.json().data.role).to.be.a('string')); "] } }]
    },
    {
      "name": "Refresh - rotate token",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" }, "url": "{{baseUrl}}/auth/refresh" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Refresh returns 200', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.collectionVariables.set('accessToken', body.data.accessToken);", "pm.collectionVariables.set('refreshToken', body.data.refreshToken);"] } }]
    },
    {
      "name": "Forgot password - sends email (SMTP required)",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\"\n}" }, "url": "{{baseUrl}}/auth/forgot-password" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Forgot password returns 200 when SMTP is configured, or 503 when SMTP is not configured', () => pm.expect([200, 503]).to.include(pm.response.code));"] } }]
    },
    {
      "name": "Reset password - token from email",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}" }, "url": "{{baseUrl}}/auth/reset-password" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Reset succeeds with the one-time token', () => pm.response.to.have.status(200));"] } }]
    },
    {
      "name": "Change password - requires current access token",
      "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"{{password}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}" }, "url": "{{baseUrl}}/auth/change-password" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Password change succeeds', () => pm.response.to.have.status(200));"] } }]
    },
    {
      "name": "Logout - revokes current session",
      "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/auth/logout" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Logout succeeds', () => pm.response.to.have.status(200));"] } }]
    }
  ]
}
