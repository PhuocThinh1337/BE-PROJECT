NODE_ENV=development
VNA_PORT=3001

# PostgreSQL: điền thông tin DB trên máy người test
VNA_DB_HOST=127.0.0.1
VNA_DB_PORT=5432
VNA_DB_USER=postgres
VNA_DB_PASSWORD=change-this-password
VNA_DB_DATABASE=ncc_auth_dev
VNA_DB_SYNCHRONIZE=true
VNA_DB_MIGRATIONS_RUN=false

# Thay bằng hai chuỗi ngẫu nhiên khác nhau trước khi chạy
VNA_TOKEN_SECRET_KEY=replace-with-a-long-random-secret
VNA_REFRESH_TOKEN_SECRET_KEY=replace-with-a-different-long-random-secret

# Tài khoản demo dùng cho seed development
AUTH_DEMO_PASSWORD=Test@123456
AUTH_DEMO_SO_EMAIL=
AUTH_DEMO_DN_EMAIL=

# SMTP để trống nếu chưa cần test gửi email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

FRONTEND_RESET_PASSWORD_URL=http://localhost:3000/reset-password
